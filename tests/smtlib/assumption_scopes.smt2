(set-logic QF_LRA)
(declare-const x Real)
(declare-const a Bool)
(declare-const b Bool)
(define-fun d () Real (ite a (+ x 1) (+ x 2)))
(assert (>= x 0))
(push 2)
(assert (not (and a b)))
(assert (< x 0))
(check-sat)
(pop 2)
(assert (and a b))
(push 1)
(declare-const scoped Real)
(assert (= scoped d))
(check-sat)
(pop 1)
(declare-const scoped Bool)
(assert scoped)
(check-sat)
(push 1)
(assert (<= d x))
(check-sat)
(pop 1)
(check-sat)
(exit)
