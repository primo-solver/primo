(set-logic QF_UF)
(declare-sort U 0)
(declare-const a U)
(declare-const b U)
(declare-fun f (U) U)
(declare-fun g (Bool) U)
(declare-const p Bool)
(assert (= a b))
(push 2)
(assert (distinct (f a) (f b)))
(check-sat)
(pop 1)
(check-sat)
(assert (distinct (g p) (g (not p))))
(check-sat)
(assert (= (g true) (g false)))
(check-sat)
(pop 1)
(check-sat)
(exit)
