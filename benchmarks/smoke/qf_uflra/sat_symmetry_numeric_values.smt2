(set-logic QF_UFLRA)
(set-info :status sat)
; Numeric values distinguish c0 from c1. Only t = c1 is satisfiable.
(declare-sort U 0)
(declare-const c0 U)
(declare-const c1 U)
(declare-const t U)
(declare-fun h (U) Real)
(assert (distinct c0 c1))
(assert (or (= t c0) (= t c1)))
(assert (= (h c0) 0))
(assert (= (h c1) 1))
(assert (= (h t) 1))
(check-sat)
