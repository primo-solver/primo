(set-logic QF_UFLRA)
(set-info :status sat)
; Equal values preserve the symmetry, so restricting t to c0 is sound.
(declare-sort U 0)
(declare-const c0 U)
(declare-const c1 U)
(declare-const t U)
(declare-fun h (U) Real)
(assert (distinct c0 c1))
(assert (or (= t c0) (= t c1)))
(assert (= (h c0) (/ 1 3)))
(assert (= (h c1) (/ 1 3)))
(assert (= (h t) (/ 1 3)))
(check-sat)
