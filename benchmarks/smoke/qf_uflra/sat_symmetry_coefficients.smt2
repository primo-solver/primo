(set-logic QF_UFLRA)
(set-info :status sat)
; Coefficients distinguish c0 from c1 despite identical arithmetic children.
(declare-sort U 0)
(declare-const c0 U)
(declare-const c1 U)
(declare-const t U)
(declare-fun h (U) Real)
(assert (distinct c0 c1))
(assert (or (= t c0) (= t c1)))
(assert (= (* 2 (h c0)) 1))
(assert (= (* 3 (h c1)) 1))
(assert (= (* 3 (h t)) 1))
(check-sat)
