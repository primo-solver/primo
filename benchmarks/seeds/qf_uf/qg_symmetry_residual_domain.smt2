(set-logic QF_UF)
(set-info :status sat)
(declare-sort A 0)
(declare-fun a () A)
(declare-fun b () A)
(declare-fun c () A)
(declare-fun op (A A) A)
(declare-fun x () A)
(assert (distinct a b c))
(assert (not (= x a)))
(assert (or (= x a) (= x b) (= x c)))
(assert (or (= (op a a) a) (= (op a a) b) (= (op a a) c)))
(assert (or (= (op b b) a) (= (op b b) b) (= (op b b) c)))
(assert (or (= (op c c) a) (= (op c c) b) (= (op c c) c)))
(assert (= x c))
(check-sat)
