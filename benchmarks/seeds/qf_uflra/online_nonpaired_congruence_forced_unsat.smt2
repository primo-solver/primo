(set-info :smt-lib-version 2.6)
(set-logic QF_UFLRA)
(set-info :status unsat)
(declare-fun x () Real)
(declare-fun y () Real)
(declare-fun u () Real)
(declare-fun v () Real)
(declare-fun p (Real) Bool)
(declare-fun q (Real) Bool)
(assert (<= x y))
(assert (<= y x))
(assert (= (+ u 1) (+ v 1)))
(assert (p x))
(assert (p y))
(assert (q u))
(assert (not (q v)))
(check-sat)
