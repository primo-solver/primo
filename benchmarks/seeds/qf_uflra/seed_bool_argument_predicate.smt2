; Boolean arguments to uninterpreted functions in a mixed QF_UFLRA seed.
(set-logic QF_UFLRA)
(declare-fun p () Bool)
(declare-fun q () Bool)
(declare-fun r () Bool)
(declare-fun f (Bool) Bool)
(declare-fun g (Bool Bool) Bool)
(declare-fun x () Real)
(assert (= p q))
(assert (or (f p) r))
(assert (or (not (f q)) (not r)))
(assert (g p q))
(assert (or (not (g q p)) r))
(assert (<= x 1))
(check-sat)
