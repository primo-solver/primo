; Boolean arguments alongside an uninterpreted sort and Real arithmetic.
(set-logic QF_UFLRA)
(declare-sort S 0)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun p () Bool)
(declare-fun q () Bool)
(declare-fun h (S Bool) S)
(declare-fun k (Bool) S)
(declare-fun x () Real)
(assert (= a b))
(assert (= p q))
(assert (or (= (h a p) (k q)) (not (= (h b q) (k p)))))
(assert (not (= (k p) a)))
(assert (<= x 1))
(check-sat)
