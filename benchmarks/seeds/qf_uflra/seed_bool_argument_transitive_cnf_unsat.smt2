; UNSAT when SAT-level CNF equivalences force a = b = c = d.
(set-logic QF_UFLRA)
(declare-fun a () Bool)
(declare-fun b () Bool)
(declare-fun c () Bool)
(declare-fun d () Bool)
(declare-fun f (Bool) Bool)
(declare-fun x () Real)
(assert (or (not a) b))
(assert (or (not b) a))
(assert (or (not b) c))
(assert (or (not c) b))
(assert (or (not c) d))
(assert (or (not d) c))
(assert (not (= (f a) (f d))))
(assert (<= 0 x))
(check-sat)
