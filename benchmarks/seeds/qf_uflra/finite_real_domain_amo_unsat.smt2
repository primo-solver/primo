(set-info :smt-lib-version 2.6)
(set-logic QF_UFLRA)
(set-info :status unsat)
(declare-fun a () Real)
(declare-fun b () Real)
(declare-fun c () Real)
(define-fun alias_a () Real a)
(define-fun alias_b () Real b)
(define-fun alias_c () Real c)
(declare-fun x () Real)
(declare-fun p (Real) Bool)
(assert (and
  (distinct alias_a alias_b alias_c)
  (or (= x alias_a) (= x alias_b) (= x alias_c))
  (= x alias_b)
  (p x)
  (not (p alias_b))))
(check-sat)
