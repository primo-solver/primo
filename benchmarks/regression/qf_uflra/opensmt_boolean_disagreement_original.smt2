; Full campaign witness retained alongside the minimized regression.
; The minimized core is opensmt_boolean_disagreement.smt2.
(set-logic QF_UFLRA)
(declare-fun a () Bool)
(declare-fun b2 () Bool)
(declare-fun b3 () Bool)
(declare-fun b () Bool)
(declare-fun b5 () Bool)
(declare-fun f (Bool) Bool)
(declare-fun g (Bool Bool) Bool)
(declare-fun x () Real)
(declare-fun y () Real)
(assert (= (f (=> b2 b)) (f (f (not b)))))
(assert (not (= (f (not (not (or b2 b)))) (f b2))))
(assert (g (f b2) (g (or (or b1 b5) (f b3)) b3)))
(assert (or (not (f (=> b2 b))) (f (not (not (or b2 b))))))
(assert (= (f (ite a (f (not b)) (not (not (or b2 b)))))
             (f (ite a (f (not b)) (not (not (or b2 b)))))))
(assert (or (not a) b2))
(assert (or (not b2) b3))
(assert (or (not b3) b))
(assert (or (not b) a))
(assert (not (= (f a) (f b))))
(assert (not (< 0 x)))
(assert (not (< y 4)))
(assert (< (+ x y) 5))
(check-sat)
