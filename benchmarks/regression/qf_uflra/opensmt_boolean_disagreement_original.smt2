; Full campaign witness retained alongside the minimized regression.
; The minimized core is opensmt_boolean_disagreement.smt2.
(set-logic QF_UFLRA)
(declare-fun b1 () Bool)
(declare-fun b2 () Bool)
(declare-fun b3 () Bool)
(declare-fun b4 () Bool)
(declare-fun b5 () Bool)
(declare-fun f (Bool) Bool)
(declare-fun g (Bool Bool) Bool)
(declare-fun x () Real)
(declare-fun y () Real)
(assert (= (f (=> b2 b4)) (f (f (not b4)))))
(assert (not (= (f (not (not (or b2 b4)))) (f b2))))
(assert (g (f b2) (g (or (or b1 b5) (f b3)) b3)))
(assert (or (not (f (=> b2 b4))) (f (not (not (or b2 b4))))))
(assert (= (f (ite b1 (f (not b4)) (not (not (or b2 b4)))))
             (f (ite b1 (f (not b4)) (not (not (or b2 b4)))))))
(assert (or (not b1) b2))
(assert (or (not b2) b3))
(assert (or (not b3) b4))
(assert (or (not b4) b1))
(assert (not (= (f b1) (f b4))))
(assert (not (< 0 x)))
(assert (not (< y 4)))
(assert (< (+ x y) 5))
(check-sat)
