# Reference papers are read locally and never committed -- they are
# copyrighted third-party material. The two named files predate this rule;
# the glob is what actually keeps the policy from depending on someone
# remembering to add each new one, after docs/papers/qflra-sri-csl-06-01.pdf
# sat untracked-but-unignored where a `git add -A docs` would have taken it.
docs/oliveras-euf.pdf
docs/Bland-or77.pdf
*.pdf
results/
fuzz-results/
yinyang_bugs/
yinyang_scratch/
slurm_logs/
slurm-results/
tmp/
sandbox/
dist/
QF_UF.tar.zst
docs/papers/model-guided-no.pdf

# local optional dependencies
contrib/local/
contrib/src/
contrib/downloads/
contrib/cadical-versions*/

# Generated mutation-fuzz seed corpus (scripts/build_fuzz_seed_corpus.py).
# Regenerate from a benchmark root rather than committing ~1.2MB of benchmarks;
# it still has to exist on disk before a cluster sync, since
# slurm_prepare_benchmark_workspace.py rsyncs with --delete.
benchmarks/seeds/qf_lra_division/
benchmarks/seeds/qf_lia_division/
build-gprof/
