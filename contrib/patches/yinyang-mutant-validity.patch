+def hoist_declarations(formula):
+    """
+    Move declarations ahead of the commands that use them.
+
+    typefuzz builds new terms out of variables of the right sort without
+    checking that the variable is declared *before* the assert it lands in, so
+    a mutant can use a symbol dozens of lines above its own declare-fun. That
+    is not valid SMT-LIB: solvers that enforce declare-before-use reject the
+    whole mutant (Primo and yices-smt2 do; z3 recovers and answers a formula
+    with the offending assertions dropped, which is worse). Measured on
+    2026-08-02 it cost 23 of 72 typefuzz mutants.
+
+    Moving a declaration earlier can never break a script -- top-level
+    declarations are global and cannot shadow -- so this is a safe
+    normalisation rather than a semantic change. Order is otherwise preserved,
+    and set-logic/set-info/set-option stay in front of the declarations they
+    have to precede.
+
+    opfuzz does not need this: it only substitutes operators in place and
+    leaves command order alone.
+    """
+    def rank(cmd):
+        text = cmd.__str__()
+        if text.startswith("(set-") or text.lstrip().startswith(";"):
+            return 0
+        if text.startswith("(declare-"):
+            return 1
+        return 2
+
+    formula.commands = sorted(formula.commands, key=rank)
+    return formula
+
+
