(set-logic QF_UF)
(declare-sort U 0)
(declare-sort V 0)
(declare-fun b0 () Bool)
(declare-fun b1 () Bool)
(declare-fun b2 () Bool)
(declare-fun u0 () U)
(declare-fun u1 () U)
(declare-fun u2 () U)
(declare-fun v0 () V)
(declare-fun fn0 (U U V) Bool)
(declare-fun fn1 (U U) U)
(declare-fun fn2 (V Bool) U)
(check-sat)
(push 2)
(assert (or (not (distinct b0 (fn0 (ite b2 u0 u2) (ite b2 u0 u2) v0))) (not (= (fn0 u1 u0 v0) (fn0 (ite b2 u0 u2) (ite b2 u0 u2) v0)))))
(assert b0)
(check-sat)
(assert b0)
(assert (not b0))
(check-sat)
(pop 1)
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert b0)
(assert (or (not (distinct b0 (fn0 (ite b2 u0 u2) (ite b2 u0 u2) v0))) (not (= (fn0 u1 u0 v0) (fn0 (ite b2 u0 u2) (ite b2 u0 u2) v0)))))
(check-sat)
(pop 1)
(pop 0)
(reset-assertions)
(push 1)
(declare-sort GateU 0)
(declare-fun gateF (Bool) GateU)
(declare-const gateB Bool)
(assert (distinct (gateF gateB) (gateF (not gateB))))
(check-sat)
(assert (= (gateF true) (gateF false)))
(check-sat)
(pop 1)
(declare-sort GateU 0)
(declare-const gateF GateU)
(check-sat)
(exit)
