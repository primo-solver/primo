#!/usr/bin/env bash
# SLURM gate for QF_LIA answer fuzzing plus model validation.
#
# A sibling of slurm_qf_lra_model_fuzz_gate.sbatch. The FuzzSMT-shard
# portion: fuzzsmt generates fresh QF_LIA instances per array task (it
# supports the logic natively -- no fuzzer changes were needed), each
# shard is checked answer-differentially against z3, and every `sat`
# result is model-validated with Dolmen (scripts/validate_model.py).
#
# --dolmen-arg=--strict=false below is required, not cosmetic: FuzzSMT's
# QF_LIA generator routinely produces `(* <let-bound-literal>
# <compound-expression>)` terms, e.g. `(* e5 e11)` where e5 happens to be
# a let-bound `1`. That is still linear (a literal times a linear
# expression is linear) but is stricter than QF_LIA's SMT-LIB grammar,
# which only allows `(* <literal> <symbol>)`. Dolmen's default --strict=true
# treats that as a Fatal Warning and aborts the whole check-model run before
# it ever evaluates the model -- verified on the cluster 2026-08-19: 39/45
# sat cases from one real shard came back model-error (each falling
# through to validate_model.py's z3-Real-only fallback, which finds no
# assignments to check for an Int model and reports validation-unavailable)
# until this flag was added, after which all 45 passed via Dolmen directly.
# The z3 fallback stays Real-only/unfixed -- not needed once Dolmen itself
# accepts the input.
#
# Also an opfuzz task and two YinYang/typefuzz tasks over a real QF_LIA
# seed corpus (benchmarks/seeds/qf_lia_division, generated by
# scripts/build_fuzz_seed_corpus.py from sandbox/non-incremental/QF_LIA --
# not committed, see .gitignore), mirroring the QF_LRA gate's own
# opfuzz/typefuzz stage. This closes a real gap, not a hypothetical one:
# 2026-08-20's real-world benchmark evaluation (docs/qf-lia-branch-and-bound.md's
# "Real-world benchmark evaluation and the fuzzing gap" section) found a
# wrong-answer bug in the `convert` family that ~14,000 cumulative
# FuzzSMT-generated cases across three prior Slurm campaigns never caught,
# root-caused to a structural blind spot in FuzzSMT's own QF_LIA defaults
# (small coefficients, few variables) rather than bad luck. Mutating real
# `convert`-family formulas (among the corpus's other 31 families) is the
# concrete fix that section calls for: it starts from the exact shape
# (large scale-canonicalizing coefficients, many atoms sharing one
# proportional polynomial) FuzzSMT structurally cannot generate on its own.
#
# Submit with a fresh PRIMO_WORKDIR. Default layout: eight FuzzSMT shards
# of 500 cases each, one opfuzz task, two YinYang/typefuzz tasks.

#SBATCH --job-name=primo-qflia-model-fuzz
#SBATCH --array=0-10
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x-%A-%a.out
#SBATCH --error=logs/%x-%A-%a.err

set -euo pipefail

WORKDIR=${PRIMO_WORKDIR:?PRIMO_WORKDIR must name the fresh remote workspace}
SOLVER_BIN=${PRIMO_FUZZ_SOLVER:-"$WORKDIR/build-slurm-rel/primo"}
# See slurm_qf_lra_model_fuzz_gate.sbatch's own comment on why this is kept
# separate from PRIMO_FUZZ_SOLVER: the Dolmen model validator takes the
# solver as a bare executable plus discrete --solver-arg entries, so flags
# folded into SOLVER_BIN would reach the answer fuzzer but not the model
# check.
SOLVER_EXTRA_ARGS=${PRIMO_FUZZ_SOLVER_EXTRA_ARGS:-""}
OUT_ROOT=${PRIMO_FUZZ_OUT_ROOT:-"$WORKDIR/fuzz-results/qf-lia-model-gate-${SLURM_ARRAY_JOB_ID:-manual}"}
TASK_ID=${SLURM_ARRAY_TASK_ID:-0}

FUZZSMT_SHARDS=${PRIMO_FUZZ_FUZZSMT_SHARDS:-8}
FUZZSMT_COUNT=${PRIMO_FUZZ_FUZZSMT_COUNT:-500}
FUZZSMT_TIMEOUT=${PRIMO_FUZZ_FUZZSMT_TIMEOUT:-5}
FUZZSMT_SEED_BASE=${PRIMO_FUZZ_FUZZSMT_SEED_BASE:-$(( ${SLURM_ARRAY_JOB_ID:-500000} % 900000 + 100000 ))}
FUZZSMT_ARGS=${PRIMO_FUZZ_FUZZSMT_ARGS:-"-ms 1 -Ms 4 -mv 1 -Mv 6 -mf 1 -mp 1 -ma 1 -Ma 4"}
MODEL_TIMEOUT=${PRIMO_FUZZ_MODEL_TIMEOUT:-10}
MODEL_DOLMEN_TIMEOUT=${PRIMO_FUZZ_MODEL_DOLMEN_TIMEOUT:-10}

OPFUZZ_TASKS=${PRIMO_FUZZ_OPFUZZ_TASKS:-1}
OPFUZZ_SEEDS=${PRIMO_FUZZ_OPFUZZ_SEEDS:-"$WORKDIR/benchmarks/seeds/qf_lia_division"}
OPFUZZ_ITERATIONS=${PRIMO_FUZZ_OPFUZZ_ITERATIONS:-200}
OPFUZZ_TIMEOUT=${PRIMO_FUZZ_OPFUZZ_TIMEOUT:-5}

YINYANG_SHARDS=${PRIMO_FUZZ_YINYANG_SHARDS:-2}
YINYANG_SEEDS=${PRIMO_FUZZ_YINYANG_SEEDS:-"$WORKDIR/benchmarks/seeds/qf_lia_division"}
YINYANG_ITERATIONS=${PRIMO_FUZZ_YINYANG_ITERATIONS:-100}
YINYANG_TIMEOUT=${PRIMO_FUZZ_YINYANG_TIMEOUT:-5}
YINYANG_WALL_SECONDS=${PRIMO_FUZZ_YINYANG_WALL_SECONDS:-1500}

MUTATION_REF=${PRIMO_FUZZ_MUTATION_REF:-"z3 model_validate=true"}

# See slurm_qf_lra_model_fuzz_gate.sbatch's own comment on why each of
# these is load-bearing (file-size limit matching the corpus builder's own
# --max-bytes, logic-restricted configs, --keep-logic/--hoist-declarations).
# QF_LIA's corpus is smaller than QF_LRA's division (32 families' smallest
# 2 files each, capped the same 200000 bytes) but the same reasoning
# applies verbatim -- this gate has not yet needed the same hardening pass
# because it has not yet run at campaign scale, not because the underlying
# typefuzz/opfuzz behavior differs by logic.
MUTATION_FILE_SIZE_LIMIT=${PRIMO_FUZZ_MUTATION_FILE_SIZE_LIMIT:-200000}
OPFUZZ_CONFIG=${PRIMO_FUZZ_OPFUZZ_CONFIG:-"$WORKDIR/benchmarks/fuzz-configs/qf_lia_operator_mutations.txt"}
YINYANG_CONFIG=${PRIMO_FUZZ_YINYANG_CONFIG:-"$WORKDIR/benchmarks/fuzz-configs/qf_lia_typefuzz.txt"}
MUTATION_KEEP_LOGIC=${PRIMO_FUZZ_MUTATION_KEEP_LOGIC-1}
MUTATION_HOIST_DECLARATIONS=${PRIMO_FUZZ_MUTATION_HOIST_DECLARATIONS-1}

cd "$WORKDIR"
mkdir -p logs "$OUT_ROOT"

PATH="$WORKDIR/contrib/local/bin:$PATH"
if [ -d "$WORKDIR/.venv-yinyang/bin" ]; then
  PATH="$WORKDIR/.venv-yinyang/bin:$PATH"
fi
export PATH

required_tools=(fuzzsmt z3 dolmen)
for required in "${required_tools[@]}"; do
  if ! command -v "$required" >/dev/null 2>&1; then
    echo "required tool '$required' not found on PATH; refusing to report a gate that ran nothing" >&2
    exit 2
  fi
done
if (( OPFUZZ_TASKS > 0 )) && ! command -v opfuzz >/dev/null 2>&1; then
  echo "required tool 'opfuzz' not found on PATH; run make contrib-yinyang before sbatch" >&2
  exit 2
fi
if (( YINYANG_SHARDS > 0 )) && ! command -v typefuzz >/dev/null 2>&1; then
  echo "required tool 'typefuzz' not found on PATH; run make contrib-yinyang before sbatch" >&2
  exit 2
fi

# Unlike QF_LRA's division (~1.2MB, kept out of git only to avoid bloating
# the repo), QF_LIA's benchmark root (sandbox/non-incremental/QF_LIA) is
# 7.7GB and already .gitignore'd wholesale -- there is no equivalent
# tmp/QF_LIA fallback root staged on a fresh SLURM workspace by default.
# So unlike ensure_seed_corpus in slurm_qf_lra_model_fuzz_gate.sbatch, a
# missing corpus here fails loudly rather than trying to rebuild it from a
# root this gate cannot assume is present: stage
# benchmarks/seeds/qf_lia_division onto the remote workspace directly
# (small enough, ~2.4MB, to scp/rsync alongside the sync step) before
# submitting, or set PRIMO_FUZZ_{OPFUZZ,YINYANG}_SEEDS to wherever it was
# staged.
require_seed_corpus() {
  local dir=$1
  if compgen -G "$dir/*.smt2" > /dev/null 2>&1; then
    echo "seed corpus $dir: $(ls "$dir"/*.smt2 | wc -l) files"
    return 0
  fi
  echo "seed corpus '$dir' is empty or missing." >&2
  echo "Stage benchmarks/seeds/qf_lia_division (scripts/build_fuzz_seed_corpus.py --root sandbox/non-incremental/QF_LIA --out benchmarks/seeds/qf_lia_division) onto the remote workspace, or pass PRIMO_FUZZ_{OPFUZZ,YINYANG}_SEEDS explicitly." >&2
  echo "Refusing to report a gate that skipped mutation fuzzing silently." >&2
  exit 2
}
if (( OPFUZZ_TASKS > 0 )); then
  require_seed_corpus "$OPFUZZ_SEEDS"
fi
if (( YINYANG_SHARDS > 0 )) && [ "$YINYANG_SEEDS" != "$OPFUZZ_SEEDS" ]; then
  require_seed_corpus "$YINYANG_SEEDS"
fi

opfuzz_start=$FUZZSMT_SHARDS
yinyang_start=$((opfuzz_start + OPFUZZ_TASKS))
total_tasks=$((yinyang_start + YINYANG_SHARDS))

if (( TASK_ID >= total_tasks )); then
  echo "task $TASK_ID is outside the active $total_tasks-task range"
  exit 0
fi

IFS=' ' read -r -a solver_words <<< "$SOLVER_BIN"
IFS=' ' read -r -a extra_args <<< "$SOLVER_EXTRA_ARGS"
model_solver_args=(--solver-arg=--quiet)
for extra in ${extra_args+"${extra_args[@]}"}; do
  model_solver_args+=("--solver-arg=$extra")
done
"${solver_words[0]}" --version

if (( TASK_ID < opfuzz_start )); then
  shard=$TASK_ID
  seed=$((FUZZSMT_SEED_BASE + shard))
  out="$OUT_ROOT/fuzzsmt/shard-$shard"
  model_out="$OUT_ROOT/model-validation/shard-$shard"
  mkdir -p "$out" "$model_out"
  echo "task $TASK_ID: QF_LIA FuzzSMT shard $shard seed $seed"
  python3 scripts/fuzz_external.py \
    --fuzzer fuzzsmt \
    --solver "$SOLVER_BIN --quiet $SOLVER_EXTRA_ARGS" \
    --refs z3 \
    --logic QF_LIA \
    --count "$FUZZSMT_COUNT" \
    --timeout "$FUZZSMT_TIMEOUT" \
    --seed "$seed" \
    --fuzzer-args "$FUZZSMT_ARGS" \
    --out "$out"
  model_status=0
  python3 scripts/validate_model.py \
    --solver "${solver_words[0]}" \
    "${model_solver_args[@]}" \
    --timeout "$MODEL_TIMEOUT" \
    --dolmen-timeout "$MODEL_DOLMEN_TIMEOUT" \
    --dolmen-arg=--strict=false \
    --out "$model_out" \
    "$out"/generated/*.smt2 || model_status=$?
  if (( model_status != 0 )); then
    # See slurm_qf_lra_model_fuzz_gate.sbatch's own comment: a lone solver
    # *answer* timeout on a hard fuzzed instance is not a model-validation
    # failure. `solver-unknown` gets the same treatment here, but only
    # because of what stage 1 QF_LIA actually is (see
    # docs/qf-lia-branch-and-bound.md's "Known incompleteness"): plain
    # branch-and-bound has no completeness argument on its own, so a
    # genuinely satisfiable instance can legitimately exhaust
    # --lia-branch-limit and come back Unknown -- confirmed by hand for
    # job 127441's one occurrence (its solver.stderr said exactly "QF_LIA
    # branch-and-bound node limit reached", not a reconstruction conflict).
    # If a future change adds a second source of Unknown for this solve
    # path (e.g. the non-IPASIR fallback's own "model reconstruction found
    # a ... conflict" outcomes -- see solve_qf_lia_impl), this blanket
    # allowance would start hiding a real bug; narrowing it to inspect each
    # case's actual message is the fix if that ever happens.
    non_timeout_failures=$(python3 -c "
import csv, sys
n = 0
with open(sys.argv[1], newline='') as fh:
    for row in csv.DictReader(fh):
        if row['outcome'] not in ('pass', 'not-sat', 'solver-timeout', 'solver-unknown'):
            n += 1
print(n)
" "$model_out/summary.csv")
    if (( non_timeout_failures > 0 )); then
      echo "model validation found $non_timeout_failures failure(s) beyond timeouts/node-limit-unknowns in $model_out/summary.csv; failing the task" >&2
      exit "$model_status"
    fi
    echo "model validation's only failures were solver timeouts/node-limit-unknowns (both benign for stage-1 QF_LIA); not failing the task" >&2
  fi
elif (( TASK_ID < yinyang_start )); then
  out="$OUT_ROOT/opfuzz/task-$TASK_ID"
  mkdir -p "$out"
  echo "task $TASK_ID: opfuzz over $OPFUZZ_SEEDS"
  scripts/yinyang_fuzz.sh \
    --typefuzz opfuzz \
    --seeds "$OPFUZZ_SEEDS" \
    --solver "$SOLVER_BIN --quiet $SOLVER_EXTRA_ARGS" \
    --ref "$MUTATION_REF" \
    --seconds "$YINYANG_WALL_SECONDS" \
    --iterations "$OPFUZZ_ITERATIONS" \
    --solver-timeout "$OPFUZZ_TIMEOUT" \
    --file-size-limit "$MUTATION_FILE_SIZE_LIMIT" \
    ${OPFUZZ_CONFIG:+--config "$OPFUZZ_CONFIG"} \
    ${MUTATION_KEEP_LOGIC:+--keep-logic} \
    --bugs "$out/bugs" \
    --scratch "$out/scratch" \
    --logs "$out/logs"
else
  out="$OUT_ROOT/yinyang/task-$TASK_ID"
  mkdir -p "$out"
  echo "task $TASK_ID: yinyang typefuzz over $YINYANG_SEEDS"
  scripts/yinyang_fuzz.sh \
    --seeds "$YINYANG_SEEDS" \
    --solver "$SOLVER_BIN --quiet $SOLVER_EXTRA_ARGS" \
    --ref "$MUTATION_REF" \
    --seconds "$YINYANG_WALL_SECONDS" \
    --iterations "$YINYANG_ITERATIONS" \
    --solver-timeout "$YINYANG_TIMEOUT" \
    --file-size-limit "$MUTATION_FILE_SIZE_LIMIT" \
    ${YINYANG_CONFIG:+--config "$YINYANG_CONFIG"} \
    ${MUTATION_KEEP_LOGIC:+--keep-logic} \
    ${MUTATION_HOIST_DECLARATIONS:+--hoist-declarations} \
    --bugs "$out/bugs" \
    --scratch "$out/scratch" \
    --logs "$out/logs"
fi
