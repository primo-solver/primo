if(NOT DEFINED PRIMO_SOURCE_DIR)
  message(FATAL_ERROR "PRIMO_SOURCE_DIR is required")
endif()
if(NOT DEFINED PRIMO_GIT_REVISION_HEADER)
  message(FATAL_ERROR "PRIMO_GIT_REVISION_HEADER is required")
endif()

if(DEFINED PRIMO_GIT_REVISION_OVERRIDE AND NOT PRIMO_GIT_REVISION_OVERRIDE STREQUAL "")
  set(PRIMO_GIT_REVISION "${PRIMO_GIT_REVISION_OVERRIDE}")
elseif(EXISTS "${PRIMO_SOURCE_DIR}/SOURCE-REVISION")
  file(READ "${PRIMO_SOURCE_DIR}/SOURCE-REVISION" PRIMO_GIT_REVISION)
  string(STRIP "${PRIMO_GIT_REVISION}" PRIMO_GIT_REVISION)
  if(PRIMO_GIT_REVISION STREQUAL "")
    set(PRIMO_GIT_REVISION "unknown")
  endif()
else()
  execute_process(
    COMMAND git rev-parse --short HEAD
    WORKING_DIRECTORY "${PRIMO_SOURCE_DIR}"
    OUTPUT_VARIABLE PRIMO_GIT_REVISION
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE PRIMO_GIT_REVISION_RESULT
    ERROR_QUIET
  )
  if(PRIMO_GIT_REVISION_RESULT)
    set(PRIMO_GIT_REVISION "unknown")
  else()
    execute_process(
      COMMAND git diff --quiet --ignore-submodules HEAD --
      WORKING_DIRECTORY "${PRIMO_SOURCE_DIR}"
      RESULT_VARIABLE PRIMO_GIT_DIRTY_RESULT
      ERROR_QUIET
    )
    execute_process(
      COMMAND git diff --cached --quiet --ignore-submodules HEAD --
      WORKING_DIRECTORY "${PRIMO_SOURCE_DIR}"
      RESULT_VARIABLE PRIMO_GIT_STAGED_RESULT
      ERROR_QUIET
    )
    if(PRIMO_GIT_DIRTY_RESULT EQUAL 1 OR PRIMO_GIT_STAGED_RESULT EQUAL 1)
      string(APPEND PRIMO_GIT_REVISION "-dirty")
    endif()
  endif()
endif()

set(PRIMO_GIT_REVISION_CONTENT
    "#pragma once\n#define PRIMO_GIT_REVISION \"${PRIMO_GIT_REVISION}\"\n")

get_filename_component(PRIMO_GIT_REVISION_DIR "${PRIMO_GIT_REVISION_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${PRIMO_GIT_REVISION_DIR}")
set(PRIMO_GIT_REVISION_OLD_CONTENT "")
if(EXISTS "${PRIMO_GIT_REVISION_HEADER}")
  file(READ "${PRIMO_GIT_REVISION_HEADER}" PRIMO_GIT_REVISION_OLD_CONTENT)
endif()
if(NOT PRIMO_GIT_REVISION_OLD_CONTENT STREQUAL PRIMO_GIT_REVISION_CONTENT)
  file(WRITE "${PRIMO_GIT_REVISION_HEADER}" "${PRIMO_GIT_REVISION_CONTENT}")
endif()
